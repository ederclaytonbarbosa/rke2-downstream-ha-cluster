global
  log stdout format raw local0
  maxconn 4096

defaults
  log global
  mode tcp
  option tcplog
  timeout connect 10s
  timeout client  1m
  timeout server  1m

frontend rke2_registration
  bind 198.51.100.10:9345
  default_backend rke2_registration_nodes

backend rke2_registration_nodes
  option tcp-check
  server workload-cp-01 198.51.100.11:9345 check
  server workload-cp-02 198.51.100.12:9345 check
  server workload-cp-03 198.51.100.13:9345 check

frontend kubernetes_api
  bind 198.51.100.10:6443
  default_backend kubernetes_api_nodes

backend kubernetes_api_nodes
  option tcp-check
  server workload-cp-01 198.51.100.11:6443 check
  server workload-cp-02 198.51.100.12:6443 check
  server workload-cp-03 198.51.100.13:6443 check

